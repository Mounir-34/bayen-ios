#include "Shared.xcconfig"

// Local development server (see server/README.md, `npm run dev` listens on :3000).
// On a physical device replace localhost with your Mac's LAN IP, e.g. http:/$()/192.168.1.20:3000/api/v1
API_BASE_URL = http:/$()/192.168.2.11:3000/api/v1
API_MODE = live
PRODUCT_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_BASE).debug
